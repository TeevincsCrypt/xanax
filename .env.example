# --- App ---
APP_NAME=Xanax
# Public https origin, no trailing slash. Used in product URLs and the x402 resource URL.
BASE_URL=http://localhost:3000
PORT=3000

# --- x402 ---
# base-sepolia (testnet, public x402.org facilitator) | base (mainnet, Coinbase CDP facilitator)
X402_NETWORK=base-sepolia
# Optional override. Testnet default: https://x402.org/facilitator. Mainnet default: CDP (needs keys below).
FACILITATOR_URL=
# Coinbase Developer Platform API key (https://portal.cdp.coinbase.com). Required when X402_NETWORK=base.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- Storage ---
# SQLite file. On Railway mount a volume at /data and use file:/data/xanax.db
DATABASE_URL=file:./data/xanax.db

# --- Email (optional; webhook is the primary channel) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Admin / secrets ---
# Bearer token for POST /admin/seed
ADMIN_TOKEN=
# HMAC key for signed download links (falls back to ADMIN_TOKEN)
SIGNING_SECRET=

# --- Limits ---
MAX_PRICE_USD=500
MAX_QTY=10

# --- Seed + test scripts (not read by the server) ---
SEED_PAYOUT_ADDRESS=
SEED_EMAIL=
SEED_WEBHOOK_URL=
# Test buyer key for scripts/test-buy.ts. Use a throwaway wallet with a little USDC only.
BUYER_PRIVATE_KEY=
# Target for scripts/test-buy.ts (defaults to BASE_URL)
TARGET_URL=
