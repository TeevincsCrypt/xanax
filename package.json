{
  "name": "xanax",
  "version": "1.0.0",
  "description": "Xanax — agent checkout for the PayBox marketplace. Sell anything to AI agents over x402.",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "test-buy": "tsx --env-file-if-exists=.env scripts/test-buy.ts"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@hono/node-server": "^2.1.5",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/extensions": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/hono": "2.28.0",
    "hono": "^4.13.13",
    "tsx": "^4.23.15",
    "viem": "^2.57.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
